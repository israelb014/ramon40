; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ramon 40"
config/description="Stylized motorcycle racing on Israeli roads."
config/version="1.0.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.06, 0.04, 0.07, 1)
boot_splash/show_image=false
config/icon="res://ui/icons/app_icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"
Save="*res://scripts/core/save_system.gd"
Controls="*res://scripts/core/controls.gd"
Game="*res://scripts/core/game.gd"
Audio="*res://audio/audio_manager.gd"
Net="*res://scripts/net/net_session.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=false

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.he.translation", "res://translations/strings.en.translation")
locale/fallback="en"
locale/include_text_server_data=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="forward_plus"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.06, 0.04, 0.07, 1)
textures/default_filters/anisotropic_filtering_level=3
